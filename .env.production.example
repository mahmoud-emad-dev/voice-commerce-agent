# Production environment template

## Core app
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE_PATH=
DEBUG_PAYLOAD_LOGS=false
ENABLE_PUBLIC_DEMO=false

## Network and admin
CORS_ALLOW_ORIGINS=["https://voice.example.com","https://store.example.com"]
ADMIN_API_KEY=replace-with-a-long-random-admin-key

## Gemini
GEMINI_API_KEY=replace-with-real-gemini-key
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

## Store branding
STORE_NAME=NEXFIT
ASSISTANT_NAME=PHOENIX
STORE_TAGLINE=Your go-to store for performance sports gear.

## WooCommerce (optional live-store path)
WC_STORE_URL=https://store.example.com
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
WC_VERIFY_SSL=true

## RAG / vector search
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
QDRANT_COLLECTION=products
QDRANT_MODE=server
QDRANT_HOST=qdrant
QDRANT_PORT=6333

## Session state / tenant persistence
POSTGRES_ENABLED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=voice_commerce
POSTGRES_USER=voice_commerce
POSTGRES_PASSWORD=replace-with-strong-db-password

## Tenant mode
TENANT_MODE=demo
DEMO_TENANT_ID=demo
DEMO_TENANT_NAME=NEXFIT Demo
DEMO_TENANT_API_KEY=replace-with-tenant-api-key
DEMO_TENANT_ALLOWED_ORIGINS=["https://voice.example.com","https://store.example.com"]
DEMO_TENANT_CATALOG_PATH=tests/products.csv

## Observability
METRICS_ENABLED=true
METRICS_REQUIRE_ADMIN_KEY=true
LLM_TRACING_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACE_PAYLOAD_PREVIEWS=false
TRACE_PREVIEW_MAX_CHARS=200

## Cost tracking
COST_TRACKING_ENABLED=true
GEMINI_ESTIMATED_TEXT_CHARS_PER_TOKEN=4
GEMINI_ESTIMATED_AUDIO_TOKENS_PER_SECOND=32
GEMINI_TEXT_INPUT_COST_PER_1M_TOKENS=0
GEMINI_TEXT_OUTPUT_COST_PER_1M_TOKENS=0
GEMINI_AUDIO_INPUT_COST_PER_1M_TOKENS=0
GEMINI_AUDIO_OUTPUT_COST_PER_1M_TOKENS=0
GEMINI_CACHE_READ_COST_PER_1M_TOKENS=0
GEMINI_CACHE_WRITE_COST_PER_1M_TOKENS=0
GEMINI_TOOL_CALL_COST_PER_1K=0
