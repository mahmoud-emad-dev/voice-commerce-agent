# Demo-safe environment template

## Gemini values
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

## App values
LOG_LEVEL=INFO
APP_ENV=local
APP_DEBUG=true
LOG_JSON=
LOG_FILE_PATH=
DEBUG_PAYLOAD_LOGS=false
ENABLE_PUBLIC_DEMO=false
CORS_ALLOW_ORIGINS=["*"]
ADMIN_API_KEY=dev-admin-key

## Store values
STORE_NAME=NEXFIT
ASSISTANT_NAME=PHOENIX
STORE_TAGLINE=Your go-to store for performance sports gear.

## WooCommerce values
WC_STORE_URL=https://store.example.com
WC_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WC_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here
WC_VERIFY_SSL=true

## RAG / Vector Search values
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
QDRANT_COLLECTION=products
QDRANT_MODE=memory
QDRANT_HOST=localhost
QDRANT_PORT=6333

## Session state / Postgres values
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_commerce
POSTGRES_USER=voice_commerce
POSTGRES_PASSWORD=voice_commerce

## Tenant values
TENANT_MODE=demo
DEMO_TENANT_ID=demo
DEMO_TENANT_NAME=NEXFIT Demo
DEMO_TENANT_API_KEY=demo-local-key
DEMO_TENANT_ALLOWED_ORIGINS=["*"]
DEMO_TENANT_CATALOG_PATH=tests/products.csv

## Observability values
METRICS_ENABLED=true
METRICS_REQUIRE_ADMIN_KEY=false
LLM_TRACING_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACE_PAYLOAD_PREVIEWS=false
TRACE_PREVIEW_MAX_CHARS=200
COST_TRACKING_ENABLED=true
GEMINI_TEXT_INPUT_COST_PER_1M_TOKENS=0
GEMINI_TEXT_OUTPUT_COST_PER_1M_TOKENS=0
GEMINI_AUDIO_INPUT_COST_PER_1M_TOKENS=0
GEMINI_AUDIO_OUTPUT_COST_PER_1M_TOKENS=0
GEMINI_CACHE_READ_COST_PER_1M_TOKENS=0
GEMINI_CACHE_WRITE_COST_PER_1M_TOKENS=0
GEMINI_TOOL_CALL_COST_PER_1K=0
